# ===========================================================================
#  Edge Telemetry Gateway — sdkconfig defaults (all targets)
# ===========================================================================

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# lwIP optimizations
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

# mbedTLS hardware acceleration
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_ECC=y
CONFIG_MBEDTLS_HARDWARE_MPI=y

CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN=y

# Session Tickets for faster TLS resumption
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# Partition table (use default single-factory for now)
