# ===========================================================================
#  Edge Companion C6 — Common sdkconfig defaults
# ===========================================================================

CONFIG_IDF_TARGET="esp32c6"

# Minimal footprint — no bluetooth, no extra features
CONFIG_BT_ENABLED=n

# WiFi (required for ESP-NOW)
CONFIG_ESP_WIFI_MODE_STATION=y

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ESP-NOW Keys (symmetric with room-monitoring)
CONFIG_ESPNOW_PMK="pmk1234567890123"
CONFIG_ESPNOW_LMK="lmk1234567890123"
